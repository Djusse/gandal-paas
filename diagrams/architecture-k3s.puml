@startuml architecture-k3s
!theme plain
title Architecture interne K3s - Détail des composants

skinparam componentStyle rectangle
skinparam linetype ortho

package "K3s Cluster" {
    
    ' Control Plane
    package "Control Plane" <<Node>> {
        component "API Server\n:6443" as api
        component "Scheduler" as scheduler
        component "Controller\nManager" as controller
        component "etcd\n(SQLite)" as etcd
        
        api -down-> etcd : "Stockage état"
        scheduler -up-> api : "Watch pods"
        controller -up-> api : "Reconciliation"
    }
    
    ' Worker (même nœud en K3s)
    package "Worker Node" <<Node>> {
        component "Kubelet" as kubelet
        component "Containerd" as containerd
        component "CNI Flannel\n10.42.0.0/16" as cni
        
        kubelet -up-> api : "Register node\nReport status"
        kubelet -down-> containerd : "Run containers"
        containerd -down-> cni : "Network setup"
    }
    
    ' Composants système
    package "kube-system namespace" {
        component "Traefik\nIngress Controller" as traefik {
            portin " :80" as traefik_80
            portin " :443" as traefik_443
        }
        
        component "CoreDNS" as coredns {
            note right
                Résolution interne:
                - *.svc.cluster.local
                - *.project-alice-memoire.svc
            end note
        }
        
        component "metrics-server" as metrics {
            note right
                Collecte métriques:
                - CPU / RAM par pod
                - Scraping kubelet
            end note
        }
        
        component "local-path\nprovisioner" as storage {
            note right
                StorageClass par défaut
                PV sur /var/lib/rancher/k3s
            end note
        }
    }
    
    ' Registry privé
    package "gandal-system namespace" {
        component "Registry Pod" as registry_pod {
            portin " :5000" as registry_port
        }
        
        database "PVC 10Gi\n/var/lib/registry" as pvc_registry
        
        registry_pod -down-> pvc_registry : "Stockage images"
        storage -up-> pvc_registry : "Provision volume"
    }
    
    ' Projet Alice
    package "project-alice-memoire namespace" {
        component "Pod my-api-1\n10.42.0.11" as pod1 {
            component "nginx:alpine" as nginx1
        }
        
        component "Pod my-api-2\n10.42.0.12" as pod2 {
            component "nginx:alpine" as nginx2
        }
        
        component "Service my-api\nClusterIP: 10.43.x.x" as svc
        
        component "Ingress my-api" as ingress {
            note bottom
                Host: my-api-memoire-alice
                      .16.170.20.250.sslip.io
                Path: /
                Backend: my-api:80
            end note
        }
        
        svc -down-> pod1
        svc -down-> pod2
        ingress -down-> svc
        
        ' Ressources de gouvernance
        rectangle "ResourceQuota" as quota {
            note right
                hard:
                  pods: 4
                  requests.cpu: 1
                  requests.memory: 1Gi
                  limits.cpu: 2
                  limits.memory: 2Gi
            end note
        }
        
        rectangle "LimitRange" as limits {
            note right
                default:
                  cpu: 500m
                  memory: 512Mi
                defaultRequest:
                  cpu: 100m
                  memory: 128Mi
            end note
        }
        
        rectangle "NetworkPolicy\nisolate-ingress" as netpol {
            note right
                Autorise:
                - Même namespace
                - kube-system (Traefik)
                Bloque:
                - Autres namespaces
            end note
        }
    }
    
    ' Projet Bob
    package "project-bob-test namespace" {
        component "Pod web-1" as bob_pod1
        component "Pod web-2" as bob_pod2
        component "Service web" as bob_svc
        component "Ingress web" as bob_ing
        
        bob_svc -down-> bob_pod1
        bob_svc -down-> bob_pod2
        bob_ing -down-> bob_svc
    }
}

' Flux de trafic externe
actor "Client HTTP" as client
client -down-> traefik_80 : "GET /\nHost: my-api-memoire-alice..."
traefik -down-> ingress : "Route selon Host"

' Flux de pull d'images
pod1 .up.> registry_port : "Pull image\n(hostPort 5000)"
pod2 .up.> registry_port : "Pull image"

' Métriques
metrics -down-> kubelet : "Scrape /metrics"

' DNS interne
pod1 .up.> coredns : "Résolution DNS\nmy-api.project-alice-memoire.svc"

' Labels de propriété
note right of pod1
    Labels:
      gandal.io/owner: alice
      gandal.io/project: memoire
      gandal.io/app: my-api
end note

@enduml
