@startuml flux-http
!theme plain
title Flux HTTP complet - De l'utilisateur au pod

actor "Client\n(Navigateur)" as client
participant "DNS\nsslip.io" as dns
participant "Elastic IP\n16.170.20.250" as eip
participant "EC2 Instance\nUbuntu" as ec2
participant "Traefik\nIngress Controller\n:80" as traefik
participant "Service\nmy-api\n10.43.5.10" as service
participant "Pod my-api-1\n10.42.0.11" as pod1
participant "Pod my-api-2\n10.42.0.12" as pod2
database "nginx\nstatic content" as nginx

== Étape 1 : Résolution DNS ==

client -> dns : DNS Query:\nmy-api-memoire-alice.16.170.20.250.sslip.io
activate dns

dns -> dns : Parse hostname:\n16.170.20.250 embedded in domain
note right
    sslip.io règle:
    Tout sous-domaine contenant une IP
    résout vers cette IP
    
    Ex: foo.1.2.3.4.sslip.io → 1.2.3.4
end note

dns --> client : DNS Response:\nA record: 16.170.20.250
deactivate dns

== Étape 2 : Connexion TCP ==

client -> eip : TCP SYN :80
activate eip
note right
    L'Elastic IP est attachée
    à l'instance EC2
end note

eip -> ec2 : Forward to eth0
activate ec2

ec2 -> ec2 : Security Group check:\nPort 80 from 0.0.0.0/0 → Allow
ec2 --> eip : TCP SYN-ACK
eip --> client : TCP SYN-ACK
client -> eip : TCP ACK
eip -> ec2 : TCP ACK

note over client, ec2
    Connexion TCP établie
end note

== Étape 3 : Requête HTTP ==

client -> ec2 : GET / HTTP/1.1\nHost: my-api-memoire-alice.16.170.20.250.sslip.io

ec2 -> traefik : Forward to localhost:80
activate traefik

traefik -> traefik : Lookup route table
note right
    Routes Traefik (configuration dynamique):
    
    1. Host: my-api-memoire-alice.16.170.20.250.sslip.io
       → Backend: my-api.project-alice-memoire.svc:80
    
    2. Host: web-test-bob.16.170.20.250.sslip.io
       → Backend: web.project-bob-test.svc:80
    
    Match sur Header "Host"
end note

traefik -> traefik : Route found:\nBackend = Service my-api

== Étape 4 : Résolution Service DNS interne ==

traefik -> "CoreDNS" : DNS Query:\nmy-api.project-alice-memoire.svc.cluster.local
activate "CoreDNS"

"CoreDNS" -> "CoreDNS" : Lookup Kubernetes Services
note right
    CoreDNS est intégré à K8s:
    - Watch Services
    - Génère records DNS automatiquement
    
    Format: <service>.<namespace>.svc.cluster.local
end note

"CoreDNS" --> traefik : DNS Response:\nA record: 10.43.5.10 (ClusterIP)
deactivate "CoreDNS"

== Étape 5 : Appel au Service ==

traefik -> service : GET / HTTP/1.1\nHost: my-api-memoire-alice...\nto 10.43.5.10:80
activate service

service -> service : Load balancing (round-robin)
note right
    Service type: ClusterIP
    
    Endpoints:
      - 10.42.0.11:80 (pod my-api-1)
      - 10.42.0.12:80 (pod my-api-2)
    
    Algorithme: round-robin
    Première requête → pod1
end note

service -> pod1 : Forward to 10.42.0.11:80
activate pod1

== Étape 6 : Traitement par nginx ==

pod1 -> nginx : Handle HTTP request
activate nginx

nginx -> nginx : Read /usr/share/nginx/html/index.html
note right
    Container nginx:alpine
    Écoute sur port 80
    
    Ressources:
      requests: 100m CPU, 128Mi RAM
      limits: 500m CPU, 512Mi RAM
    
    Probes:
      readiness: tcpSocket:80 every 5s
      liveness: tcpSocket:80 every 5s
end note

nginx --> pod1 : HTTP 200 OK\nContent-Type: text/html\n\n<!DOCTYPE html>...
deactivate nginx

pod1 --> service : HTTP 200 + HTML body
deactivate pod1

== Étape 7 : Réponse ==

service --> traefik : HTTP 200 + HTML
deactivate service

traefik -> traefik : Add response headers:\nX-Forwarded-For, X-Real-IP, etc.

traefik --> ec2 : HTTP 200 + HTML
deactivate traefik

ec2 --> eip : HTTP 200 + HTML
deactivate ec2

eip --> client : HTTP 200 + HTML
deactivate eip

client -> client : Render HTML page

== Requête suivante (même client) ==

client -> ec2 : GET / HTTP/1.1 (2nd request)
ec2 -> traefik : Forward
traefik -> service : to 10.43.5.10:80
service -> service : Load balance: round-robin
service -> pod2 : Forward to 10.42.0.12:80 (pod2 this time)
activate pod2

pod2 -> nginx : Handle request
nginx --> pod2 : HTTP 200 + HTML
pod2 --> service : HTTP 200
deactivate pod2

service --> traefik : HTTP 200
traefik --> ec2 : HTTP 200
ec2 --> client : HTTP 200

note over client, pod2
    La charge est répartie entre les 2 pods
    Requête 1 → pod1
    Requête 2 → pod2
    Requête 3 → pod1 (round-robin)
end note

@enduml
