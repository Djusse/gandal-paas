DATABASE_URL=postgresql+psycopg://paas:paas@localhost:5432/paas
GITLAB_MODE=fake
ORCHESTRATOR_MODE=mock
AUTH_MODE=dev
WEBHOOK_SECRET=change-me-long-random
INTERNAL_TOKEN=change-me-long-random
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_GROUP_ID=0
GITLAB_CA_BUNDLE=
CI_TEMPLATE=templates/build.yml@paas/ci-templates
WEBHOOK_PUBLIC_URL=http://localhost:8000

# Orchestrateur (plan d'exécution)
ORCHESTRATOR_URL=http://localhost:8100
ORCHESTRATOR_TOKEN=change-me-long-random
ORCHESTRATOR_TIMEOUT=15
ORCHESTRATOR_RETRIES=3

# Alignement sur l'infra (D8)
DEFAULT_REPLICAS=2

# Relance périodique (R1, R11)
RECOVERY_ENABLED=true
RECOVERY_INTERVAL=60
REQUESTED_TIMEOUT=120
DEPLOYING_TIMEOUT=300

# CORS : liste séparée par des virgules, ou * en développement
CORS_ORIGINS=*
