# Environnement d'intégration (deploy/docker-compose.yml)
POSTGRES_USER=paas
POSTGRES_PASSWORD=paas
POSTGRES_DB=paas

GITLAB_MODE=fake
ORCHESTRATOR_MODE=mock
AUTH_MODE=dev

WEBHOOK_SECRET=dev-webhook-secret
INTERNAL_TOKEN=dev-internal-token
ORCHESTRATOR_TOKEN=dev-orchestrator-token

DEFAULT_REPLICAS=2
RECOVERY_ENABLED=true
RECOVERY_INTERVAL=60
CORS_ORIGINS=*

# Orchestrateur (profil "cluster")
GANDAL_BASE_DOMAIN=sslip.io
GANDAL_INGRESS_CLASS=traefik
GANDAL_REPLICAS=2
GANDAL_RECONCILE_INTERVAL=30
GANDAL_ROLLOUT_TIMEOUT=300
KUBECONFIG_PATH=~/.kube/config
